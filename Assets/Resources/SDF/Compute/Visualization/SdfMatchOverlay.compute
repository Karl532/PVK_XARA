#pragma kernel CSClear2D
#pragma kernel CSBuildMask2D

RWTexture2D<float> _MatchMask2D;
Texture3D<float> _GlobalTsdf3D;
SamplerState sampler_linear_clamp;
Texture2DArray<float> _DepthTex;
float2 _DepthSize;
int _EyeSlice;
int _FlipY;
float4x4 _InvDepthViewProj;
float4x4 _TrackingToWorld;
float4x4 _WorldToWorkspace;
float _Tolerance;
float3 _GlobalCorner;
float3 _GlobalSize;

[numthreads(8,8,1)]
void CSClear2D(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_DepthSize.x || id.y >= (uint)_DepthSize.y)
        return;
    _MatchMask2D[int2(id.xy)] = 0.0;
}

float3 ReconstructWorld(int2 pixel, float depth01)
{
    float2 uv = (float2(pixel) + 0.5) / max(_DepthSize, 1.0);
    if (_FlipY != 0)
        uv.y = 1.0 - uv.y;
    float2 ndcXY = uv * 2.0 - 1.0;
    float zNdc = depth01 * 2.0 - 1.0;
    float4 clip = float4(ndcXY.x, ndcXY.y, zNdc, 1.0);

    float4 trackingH = mul(_InvDepthViewProj, clip);
    float3 tracking = trackingH.xyz / max(1e-6, trackingH.w);
    float4 worldH = mul(_TrackingToWorld, float4(tracking, 1.0));
    return worldH.xyz;
}

[numthreads(8,8,1)]
void CSBuildMask2D(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_DepthSize.x || id.y >= (uint)_DepthSize.y)
        return;

    float depth01 = _DepthTex.Load(int4((int)id.x, (int)id.y, _EyeSlice, 0));
    if (depth01 <= 1e-6)
        return;

    float3 worldPos = ReconstructWorld(int2(id.xy), depth01);
    float3 ws = mul(_WorldToWorkspace, float4(worldPos, 1.0)).xyz;
    float3 uvw = (ws - _GlobalCorner) / max(_GlobalSize, 1e-6);
    if (any(uvw < 0.0) || any(uvw > 1.0))
        return;

    float dist = _GlobalTsdf3D.SampleLevel(sampler_linear_clamp, uvw, 0);
    if (abs(dist) > _Tolerance)
        return;

    _MatchMask2D[int2(id.xy)] = 1.0;
}
